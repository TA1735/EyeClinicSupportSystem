{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://eye-clinic-system-web.vercel.app"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EyeClinicDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "SecretKey": "YOUR_SUPER_SECURE_SECRET_KEY_MINIMUM_32_CHARACTERS_HERE",
    "Issuer": "https://api.ecs-medical.com",
    "Audience": "https://portal.ecs-medical.com",
    "ExpireHours": "24"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "admin.eyeclinic@gmail.com",
    "Password": "YOUR_SMTP_APP_PASSWORD",
    "UseSsl": true,
    "SenderEmail": "your-email@gmail.com",
    "SenderName": "ECS Medical"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET",
    "Folder": "ecs-medical-records",
    "SignedUrlTtlSeconds": 300
  },
  "MongoDb": {
    "ConnectionString": "mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=ecs-schema&retryWrites=true&w=majority",
    "Database": "ecs_clinic",
    "MedicalRecordsCollection": "medical_records",
    "LabResultsCollection": "lab_results",
    "AiSuggestionsCollection": "ai_suggestions",
    "RecordApprovalsCollection": "record_approvals",
    "ApplicationName": "ecs-backend",
    "ServerSelectionTimeoutSeconds": 30
  },
  "AiService": {
    "BaseUrl": "https://eye-clinic-system-ai.onrender.com",
    "ApiPrefix": "/api/v1/ai",
    "PredictTimeoutSeconds": 60,
    "PollIntervalSeconds": 1,
    "MaxPollAttempts": 60,
    "MaxConcurrentTasks": 2
  }
}